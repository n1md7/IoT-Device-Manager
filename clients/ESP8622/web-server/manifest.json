{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_net.json",
    "$(MODDABLE)/modules/files/preference/manifest.json",
    "$(MODDABLE)/modules/files/file/manifest.json",
    "$(MODULES)/pins/digital/manifest.json",
    "$(MODDABLE)/modules/network/mdns/manifest.json"
  ],
  "modules": {
    "*": ["./src/*", "$(MODULES)/network/http/*", "$(MODULES)/network/sntp/*"],
    "routes/*": "./src/routes/*",
    "services/*": "./src/services/*",
    "controllers/*": "./src/controllers/*",
    "managers/*": "./src/managers/*",
    "storages/*": "./src/storages/*",
    "database/*": "./src/database/*",
    "server/*": "./src/server/*",
    "utils/*": "./src/utils/*"
  },
  "data": {
    "*": ["./public/*"]
  },
  "preload": ["http", "sntp"],
  "config": {
    "code": "D0001",
    "version": "1.0.0",
    "name": "Device controller",
    "description": "Device controller using NodeMCU via WEB interface"
  }
}
