{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_net.json",
    "$(MODDABLE)/modules/files/preference/manifest.json",
    "$(MODDABLE)/modules/files/file/manifest.json",
    "$(MODULES)/pins/digital/manifest.json",
    "$(MODDABLE)/modules/network/mdns/manifest.json"
  ],
  "modules": {
    "*": ["./src/*", "$(MODULES)/network/http/*", "$(MODULES)/network/sntp/*"],
    "routes/*": "./src/routes/*",
    "services/*": "./src/services/*",
    "controllers/*": "./src/controllers/*",
    "managers/*": "./src/managers/*",
    "storages/*": "./src/storages/*",
    "database/*": "./src/database/*",
    "server/*": "./src/server/*",
    "utils/*": "./src/utils/*"
  },
  "data": {
    "*": ["./clientApp/dist/*", "./clientApp/public/*"]
  },
  "preload": [
    "http",
    "sntp",
    "utils/validations",
    "utils/http",
    "utils/env",
    "utils/config",
    "utils/console",
    "utils/interval",
    "services/logger",
    "services/extension",
    "services/time",
    "services/mdns",
    "services/switch",
    "services/schedule",
    "services/counter",
    "server/router",
    "server/express",
    "database/storage",
    "storages/ids",
    "storages/unique-id",
    "managers/switches",
    "managers/schedules",
    "controllers/switch.controller",
    "controllers/schedule.controller"
  ],
  "config": {
    "code": "D0001",
    "version": "1.0.0",
    "domain": "node-mcu",
    "environment": "production",
    "description": "Device controller using NodeMCU via WEB interface"
  }
}
