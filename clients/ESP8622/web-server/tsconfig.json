{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "routes/*": ["./src/routes/*"],
      "services/*": ["./src/services/*"],
      "utils/*": ["./src/utils/*"],
      "controllers/*": ["./src/controllers/*"],
      "managers/*": ["./src/managers/*"],
      "database/*": ["./src/database/*"],
      "storages/*": ["./src/storages/*"],
      "server/*": ["./src/server/*"]
    }
  },
  "include": [
    "src/**/*",
    "node_modules/@moddable/typings/**/*.d.ts",
    "vitest/globals"
  ],
  "exclude": ["archived/front-end", "mock-api", "clientApp"]
}
