{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "routes/*": ["./src/routes/*"],
      "services/*": ["./src/services/*"],
      "utils/*": ["./src/utils/*"],
      "controllers/*": ["./src/controllers/*"],
      "managers/*": ["./src/managers/*"],
      "database/*": ["./src/database/*"],
      "storages/*": ["./src/storages/*"],
      "express": ["../express/src/express.ts"],
      "express/*": ["../express/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../express/src/**/*",
    "node_modules/@moddable/typings/**/*.d.ts",
    "vitest/globals"
  ],
  "exclude": ["archived/front-end", "mock-api", "clientApp"]
}
